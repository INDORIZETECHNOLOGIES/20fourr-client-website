# Copy to .env.local. Server-side only — never expose the API origin to the browser.
API_BASE_URL=http://localhost:3000/api/v1

# Razorpay publishable key id (rzp_test_… / rzp_live_…). Public by design; the
# secret half belongs to the API only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# API origin for Socket.io (no /api/v1 path). Must also be listed in the API's
# ALLOWED_ORIGINS or the handshake is refused.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
